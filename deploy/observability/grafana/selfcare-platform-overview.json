        },
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "definition": "label_values(jvm_threads_live_threads{app_kubernetes_io_part_of=\"selfcare-platform\"}, application)",
        "includeAll": true,
        "label": "Service",
        "multi": false,
        "name": "service",
        "query": {
          "query": "label_values(jvm_threads_live_threads{app_kubernetes_io_part_of=\"selfcare-platform\"}, application)",
          "refId": "StandardVariableQuery"
        },
        "refresh": 1,
        "type": "query"
      }
    ]
  },
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timezone": "",
  "title": "Selfcare Platform Overview",
  "uid": "selfcare-platform-overview",
  "version": 1,
